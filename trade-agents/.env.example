# Trade Agents 周度分析 · 环境变量模板
# 用法：复制为 .env，填入真实值后 `set -a && source .env && set +a`

# ── Tushare（代理版，走 https://ttx.dailyfetch.top/）──
TUSHARE_TOKEN=

# ── DeepSeek（模型 deepseek-v4-pro）──
DEEPSEEK_API_KEY=

# ── 飞书自建应用（图文卡片推送）──
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── 飞书群 chat_id（oc_xxx）──
FEISHU_CHAT=
